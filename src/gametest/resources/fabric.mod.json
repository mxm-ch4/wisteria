{
	"schemaVersion": 1,
	"id": "wisteria-gate",
	"version": "${version}",
	"name": "Wisteria gate",
	"description": "Client game tests: the readiness gate and one test per module. Dev-only, never shipped.",
	"license": "GPL-3.0-only",
	"environment": "client",
	"entrypoints": {
		"fabric-client-gametest": [
			"dev.wisteria.gate.GateTest",
			"dev.wisteria.gate.TextQualityGameTest",
			"dev.wisteria.gate.ClickEverythingGameTest",
			"dev.wisteria.gate.CoreGameTest",
			"dev.wisteria.gate.HudGameTest",
			"dev.wisteria.gate.modules.EspGameTest",
			"dev.wisteria.gate.ProxyGameTest",
			"dev.wisteria.gate.MenuGameTest",
			"dev.wisteria.gate.modules.FullBrightGameTest"
		]
	},
	"depends": {
		"wisteria": "*",
		"fabric-api": "*"
	}
}
